{
  "name": "brew-buddies-api",
  "version": "0.1.0",
  "private": true,
  "description": "Brew Buddies matching API — Cloudflare Worker + D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute brewbuddy-db --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute brewbuddy-db --file=./schema.sql --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250808.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
