{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brew-buddies-site",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "website",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.brew-buddies.com", "custom_domain": true },
    { "pattern": "brew-buddies.com", "custom_domain": true }
  ]
}
